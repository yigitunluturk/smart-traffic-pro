   "source": [
    "# YOLO11 + BoT-SORT ile araç hız hesaplama \n",
    "from ultralytics import YOLO"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "432104a2-7dc3-4edf-85f4-46d342b0d8db",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "os.environ[\"KMP_DUPLICATE_LIB_OK\"]=\"TRUE\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "ee8caccc",
   "metadata": {},
   "outputs": [],
   "source": [,
    "model = YOLO('yolo11m.pt')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "89f07617",
   "metadata": {},
   "source": [,
    "\n",
    "Araçların hızını ölçüyoruz. Mantık şöyle: yolun her iki tarafında kesikli çizgiler var ve bu çizgilerin arası **9.144 metre**. Aracın bir bölgeden diğerine gidene kadar geçen süreyi bulup bu mesafeye oranlayarak ortalama hızı buluyoruz.\n",
    "\n",
    "Çizgilere tam denk gelmek zor olduğu için (aracın orta noktası 4-5 piksel kayabiliyor) çizgi yerine **dikdörtgen bölgeler** tanımlıyoruz. Araç bölgeye girdiğinde giriş anı kaydediliyor.\n",
    "\n",
    "Sağdaki kesikli çizgi arası 86 piksel, soldaki 74 piksel. Bölge kullandığımız için aracın iki bölgeye girdiği noktalar arası dikey piksel farkını ölçüp oran-orantı yapıyoruz: sağda 86 piksel = 9.144 m ise, ölçtüğümüz `x` piksel = `(x*9.144)/86` metre.\n",
    "\n",
    "**Önemli fark (eski koda göre):** Eski kodda süre `time.time()` (duvar saati) ile ölçülüyordu ve işlem FPS'ine bağlı olduğu için `30/fps` çarpanıyla telafi ediliyordu. Burada bunun yerine **frame numarası farkını video FPS'ine bölerek** süreyi videonun kendi zaman ekseninden okuyoruz:\n",
    "\n",
    "`geçen_süre = (çıkış_frame - giriş_frame) / video_fps`\n",
    "\n",
    "Bu yöntem işlem hızından tamamen bağımsızdır; `time.time()` ve `30/fps` çarpanına artık gerek yoktur."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "2a9a5ec4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Video FPS: 29.982105542289595\n"
     ]
    }
   ],
   "source": [
    "import cv2\n",
    "import numpy as np\n",
    "\n",
    "# Kullanacağımız video.\n",
    "kamera = cv2.VideoCapture('trafik.mp4')\n",
    "\n",
    "# Videonun gerçek FPS'i. Süre hesabını buna göre yapacağız.\n",
    "video_fps = kamera.get(cv2.CAP_PROP_FPS)\n",
    "print(\"Video FPS:\", video_fps)\n",
    "\n",
    "font = cv2.FONT_HERSHEY_SIMPLEX\n",
    "\n",
    "\n",
    "\n",
    "# --- Yolun SAĞ tarafı için bölgeler ---\n",
    "# Aracın girdiği bölge\n",
    "region1 = np.array([(700,575),(1100,575),(1100,560),(700,560)]).reshape((-1,1,2))\n",
    "# Aracın çıktığı bölge (ekranda kırmızı gösterilir)\n",
    "region2 = np.array([(700,489),(1000,489),(1000,400),(700,400)]).reshape((-1,1,2))\n",
    "\n",
    "# --- Yolun SOL tarafı için bölgeler ---\n",
    "# Aracın girdiği bölge\n",
    "region3 = np.array([(320,466),(580,466),(580,480),(320,480)]).reshape((-1,1,2))\n",
    "# Aracın çıktığı bölge (ekranda kırmızı gösterilir)\n",
    "region4 = np.array([(200,540),(550,540),(520,660),(70,660)]).reshape((-1,1,2))\n",
    "\n",
    "# Sağ taraftaki kesikli çizgiler arası piksel farkı\n",
    "uzunluk = 86\n",
    "# Sol taraftaki kesikli çizgiler arası piksel farkı\n",
    "uzunluk2 = 74\n",
    "# Kesikli çizgiler arası gerçek mesafe (metre)\n",
    "distance = 9.144"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "f74922b9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Her araç kendi id'si ile sözlüklerde tutuluyor.\n",
    "\n",
    "# --- Yolun SAĞI ---\n",
    "vehicles_entering = {}       # giriş bölgesine girdiği FRAME numarası\n",
    "vehicles_konum = {}          # giriş bölgesine girdiği dikey konum (cy)\n",
    "vehicles_speed = {}          # hesaplanan hız (bir kere hesaplanır)\n",
    "vehicles_elapsed_time = {}   # iki bölge arası geçen süre (bir kere hesaplanır)\n",
    "\n",
    "# --- Yolun SOLU ---\n",
    "vehicles_entering2 = {}\n",
    "vehicles_konum2 = {}\n",
    "vehicles_speed2 = {}\n",
    "vehicles_elapsed_time2 = {}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "0554c776",
   "metadata": {},
   "outputs": [],
   "source": [
    "frame_no = 0\n",
    "araclar = [2, 5, 7] \n",
    "while True:\n",
    "    ret, kare = kamera.read()\n",
    "    # Video bittiğinde ret False döner; çökmemek için döngüyü kırıyoruz.\n",
    "    if not ret:\n",
    "        break\n",
    "\n",
    "    frame_no += 1\n",
    "\n",
    "    # Çıkış bölgelerini ekrana çiziyoruz (giriş bölgeleri yorumda).\n",
    "    cv2.polylines(kare, [region2], True, (0,0,255), 2)\n",
    "    cv2.polylines(kare, [region4], True, (0,0,255), 2)\n",
    "\n",
    "    # YOLO11 + BoT-SORT ile tespit + tracking tek çağrıda.\n",
    "    # persist=True: frame'ler arası id sürekliliği korunur.\n",
    "    # classes=araclar: sadece araçlar tespit edilir.\n",
    "    # tracker='botsort.yaml': BoT-SORT kullanılır (Ultralytics ile gelir).\n",
    "    results = model.track(\n",
    "        kare,\n",
    "        persist=True,\n",
    "        classes=araclar,\n",
    "        conf=0.5,\n",
    "        tracker='botsort.yaml',\n",
    "        verbose=False\n",
    "    )\n",
    "\n",
    "    # Bu frame'de takip edilen kutu yoksa atla.\n",
    "    if results[0].boxes.id is None:\n",
    "        cv2.imshow(\"kamera\", kare)\n",
    "        if cv2.waitKey(1) & 0xFF == ord('q'):\n",
    "            break\n",
    "        continue\n",
    "\n",
    "    # Kutular (xywh: merkez x, merkez y, genişlik, yükseklik) ve id'ler.\n",
    "    boxes = results[0].boxes.xywh.cpu().numpy()\n",
    "    ids = results[0].boxes.id.cpu().numpy().astype(int)\n",
    "    clss = results[0].boxes.cls.cpu().numpy().astype(int)   # sınıf indisleri\n",
    "\n",
    "    for (cx, cy, w, h), isim, sinif in zip(boxes, ids, clss):\n",
    "        arac_tipi = model.names[sinif]\n",
    "        cx, cy = int(cx), int(cy)\n",
    "        # Sol-üst köşe (yazıyı oraya basacağız).\n",
    "        x = int(cx - w/2)\n",
    "        y = int(cy - h/2)\n",
    "\n",
    "        ##################  YOLUN SAĞ KISMI  ##################\n",
    "        # Sağ giriş bölgesine girdi mi?\n",
    "        inside_region1 = cv2.pointPolygonTest(region1, (cx, cy), False)\n",
    "        if inside_region1 > 0:\n",
    "            # Sadece ilk girişte kaydet; her frame üzerine yazılmasın diye.\n",
    "            if isim not in vehicles_entering:\n",
    "                vehicles_entering[isim] = frame_no\n",
    "                vehicles_konum[isim] = cy\n",
    "\n",
    "        if isim in vehicles_entering:\n",
    "            # Sağ çıkış bölgesine girdi mi?\n",
    "            inside_region2 = cv2.pointPolygonTest(region2, (cx, cy), False)\n",
    "            if inside_region2 > 0:\n",
    "                # Süre: frame farkı / video fps (işlem hızından bağımsız)\n",
    "                if isim not in vehicles_elapsed_time:\n",
    "                    frame_farki = frame_no - vehicles_entering[isim]\n",
    "                    vehicles_elapsed_time[isim] = frame_farki / video_fps\n",
    "                elapsed_time = vehicles_elapsed_time[isim]\n",
    "\n",
    "                # İki bölge arası ölçülen dikey piksel farkı\n",
    "                mesafe = vehicles_konum[isim] - cy\n",
    "\n",
    "                # Bu araç için hız ilk kez hesaplanıyorsa\n",
    "                if isim not in vehicles_speed and elapsed_time > 0:\n",
    "                    # m/s -> km/h\n",
    "                    a_speed_kh = (distance / elapsed_time) * 3.6\n",
    "                    # Her aracın bölgeler arası piksel farkı değişebileceği için\n",
    "                    # gerçek piksel farkına göre oran-orantı düzeltmesi.\n",
    "                    real_kh = a_speed_kh * mesafe / uzunluk\n",
    "                    vehicles_speed[isim] = int(real_kh)\n",
    "\n",
    "                if isim in vehicles_speed:\n",
    "                    sag_hiz = str(vehicles_speed[isim]) + ' km/h'\n",
    "                    cv2.putText(kare, sag_hiz, (x, y), font, 1.7, (0,150,255), 3)\n",
    "\n",
    "        ##################  YOLUN SOL KISMI  ##################\n",
    "        # Mantık sağ ile aynı.\n",
    "        inside_region3 = cv2.pointPolygonTest(region3, (cx, cy), False)\n",
    "        if inside_region3 > 0:\n",
    "            if isim not in vehicles_entering2:\n",
    "                vehicles_entering2[isim] = frame_no\n",
    "                vehicles_konum2[isim] = cy\n",
    "\n",
    "        if isim in vehicles_entering2:\n",
    "            inside_region4 = cv2.pointPolygonTest(region4, (cx, cy), False)\n",
    "            if inside_region4 > 0:\n",
    "                if isim not in vehicles_elapsed_time2:\n",
    "                    frame_farki2 = frame_no - vehicles_entering2[isim]\n",
    "                    vehicles_elapsed_time2[isim] = frame_farki2 / video_fps\n",
    "                elapsed_time2 = vehicles_elapsed_time2[isim]\n",
    "\n",
    "                # Solda araç aşağı doğru gittiği için fark negatif; pozitife çeviriyoruz.\n",
    "                mesafe2 = -(vehicles_konum2[isim] - cy)\n",
    "\n",
    "                if isim not in vehicles_speed2 and elapsed_time2 > 0:\n",
    "                    a_speed_kh2 = (distance / elapsed_time2) * 3.6\n",
    "                    real_kh2 = a_speed_kh2 * mesafe2 / uzunluk2\n",
    "                    vehicles_speed2[isim] = int(real_kh2)\n",
    "\n",
    "                if isim in vehicles_speed2:\n",
    "                    sol_hiz = str(vehicles_speed2[isim]) + ' km/h'\n",
    "                    cv2.putText(kare, sol_hiz, (x, y), font, 1.7, (0,255,255), 3)\n",
    "\n",
    "    cv2.imshow(\"kamera\", kare)\n",
    "    if cv2.waitKey(1) & 0xFF == ord('q'):\n",
    "        break\n",
    "\n",
    "kamera.release()\n",
    "cv2.destroyAllWindows()"
   ]
  }
 ],
